# Supabase (https://supabase.com → 프로젝트 설정 → API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_KEY=your-service-role-key

# Google Gemini (https://aistudio.google.com/app/apikey → 무료)
GEMINI_API_KEY=your-gemini-api-key

# DART 전자공시 (https://opendart.fss.or.kr → API 신청 → 무료)
DART_API_KEY=your-dart-api-key

# 한국은행 ECOS (https://ecos.bok.or.kr/api → 회원가입 후 무료 발급)
ECOS_API_KEY=your-ecos-api-key
